# Fuzzy c-means figure — the hand-set cluster numbers, in one file.
#
# Figure 4's c-means panels are built around clusters chosen by eye: which
# trajectory groups carry the VEGF signal, which pair up across tissues, which
# get highlighted. Those numbers are not derived from anything — they are read
# off the clustering and written down — and they MOVE whenever the clustering is
# rerun.
#
# That is not hypothetical. motrpac-human-presuspension-acute PR #4 ("updated c-means analysis to
# the big fix with new c-means clusters") is almost entirely the work of chasing
# these numbers through a script after blood was re-clustered at k = 12: blood's
# VEGF clusters went from c(4,5) to c(7,9), adipose's selection changed, and the
# script had to be edited in six places to match. Keeping them here means the
# next re-clustering is an edit to this file and nothing else.
#
# Read from R with cmeans_clusters("VEGF_BLOOD") in helpers/FIG4_ED5.R, beside
# this file, which parses the comma-separated lists and fails loudly on an unset
# name.
#
# helpers/FIG4_ED5.R sources it, so a panel needs no setup beyond sourcing the
# helper. The signature the panels are built around is in config/highlights.json.

# ---- what the figure is about -----------------------------------------------

# The ome the signature's features are taken from.
export CMEANS_OME="${CMEANS_OME:-transcript-rna-seq}"

# A feature belongs to a cluster for the hard-assignment panels when its
# membership exceeds this. 0.3 is the legacy value.
export CMEANS_CLUSTER_THRESHOLD="${CMEANS_CLUSTER_THRESHOLD:-0.3}"

# ---- FIG4E — the sparkline grid ---------------------------------------------

# Which clusters get a sparkline, per tissue, in the order they are drawn.
export CMEANS_SPARKLINE_ADIPOSE="${CMEANS_SPARKLINE_ADIPOSE:-8}"
export CMEANS_SPARKLINE_BLOOD="${CMEANS_SPARKLINE_BLOOD:-7,9}"
export CMEANS_SPARKLINE_MUSCLE="${CMEANS_SPARKLINE_MUSCLE:-6,10,12,7}"

# ---- the VEGF-enriched clusters ---------------------------------------------
#
# These are the numbers PR #4 exists to correct. Blood was c(4,5) before the
# re-clustering and is c(7,9) after.
export CMEANS_VEGF_ADIPOSE="${CMEANS_VEGF_ADIPOSE:-8}"
export CMEANS_VEGF_BLOOD="${CMEANS_VEGF_BLOOD:-7,9}"
export CMEANS_VEGF_MUSCLE_EARLY="${CMEANS_VEGF_MUSCLE_EARLY:-10,6}"
export CMEANS_VEGF_MUSCLE_MIDDLE="${CMEANS_VEGF_MUSCLE_MIDDLE:-12}"
export CMEANS_VEGF_MUSCLE_LATE="${CMEANS_VEGF_MUSCLE_LATE:-7}"

# ---- FIG4F, ED5D, ED5E — the three cross-tissue heatmaps --------------------
#
# Each is muscle clusters on the rows, optionally restricted to features that
# also land in a named cluster of a second tissue. FIG4F has no second tissue.
export CMEANS_HEATMAP_MUSCLE_ADIPOSE_EARLY="${CMEANS_HEATMAP_MUSCLE_ADIPOSE_EARLY:-10,6}"
export CMEANS_HEATMAP_MUSCLE_BLOOD_MIDDLE="${CMEANS_HEATMAP_MUSCLE_BLOOD_MIDDLE:-12}"
export CMEANS_HEATMAP_MUSCLE_LATE="${CMEANS_HEATMAP_MUSCLE_LATE:-7}"

# ---- ED5C — the UpSet -------------------------------------------------------
#
# Clusters combined into one UpSet set, because they are the same trajectory
# split by the clustering rather than two findings.
export CMEANS_UPSET_BLOOD_COMBINED="${CMEANS_UPSET_BLOOD_COMBINED:-7,9}"
export CMEANS_UPSET_MUSCLE_COMBINED="${CMEANS_UPSET_MUSCLE_COMBINED:-6,10}"

# ---- timepoint grouping -----------------------------------------------------
#
# Blood's post-10-min and post-15/30/45-min trajectories are reported together:
# a trajectory peaking at either is the same biology, and separating them split
# one cluster's label across two headers. Muscle and adipose are unaffected.
export CMEANS_BLOOD_MERGE_P10_INTO_P15="${CMEANS_BLOOD_MERGE_P10_INTO_P15:-TRUE}"

# ---- FIG4C label placement overrides ----------------------------------------
#
# The greedy placement in helpers/FIG4_ED5.R spreads cluster labels along the x
# axis, and two labels are then moved by hand because the result still collides.
# Both move the LABEL only; neither touches the data.
#
# Written as "<tissue>:<cluster>:<timepoint>". A timepoint of "match:<cluster>"
# puts the label wherever that other cluster's label ended up, falling back to
# the timepoint after the colon if that cluster has none.
export CMEANS_LABEL_OVERRIDES="${CMEANS_LABEL_OVERRIDES:-blood:7:match:1:P15-45M,adipose:13:P24H}"

