# figures/landscape — the variables a figure script or a fit reads at run time.
#
# Everything here takes an inline override:  RASTER_DPI=300 Rscript FIG3.R
#
# There is no build system. Source this file before a run, or set the handful of
# variables that matter to you and leave the rest at their defaults:
#
#   source figures/landscape/config/landscape.env
#   Rscript figures/landscape/figure_2/FIG2.R

# ---- Where this tree is ----------------------------------------------------
# Every script resolves the paths it touches from this, so it can be run from
# any working directory. It names figures/landscape/, not the repository root,
# and every path in config/*.json is relative to it.
export LANDSCAPE_ROOT="${LANDSCAPE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)}"

# ---- Rasterisation resolution ----------------------------------------------
# The dpi every rasterised layer is drawn at, for every panel that rasterises
# one: the dense scatters in FIG3A, ED3A and ED3E. One value rather than a
# per-panel setting, because it is a property of how this code renders and not a
# fact about any one figure.
#
# Only the dense layer is rasterised — axes, strips, labels and fit lines stay
# vector and editable — so this decides the resolution of the point cloud alone.
# maybe_rasterise() in lib/panel_export.R reads it; panel_map.json carries the
# same default for a script run with this file unsourced.
export RASTER_DPI="${RASTER_DPI:-600}"

# ---- Which single-feature plots to draw ------------------------------------
# single_feature_plots.R draws its whole catalog when run directly.
# PLOTS=ED2B,FIG7C restricts it to a subset. Unset means all of them.
export PLOTS="${PLOTS:-}"

# ---- Tooling ---------------------------------------------------------------
# The gsutil every bucket read shells out to: the epigenomics QC download
# (load_qc(epigen = TRUE) in FIG1C, ED1B, ED1D and SF1), the SF1C-SF1F raw ATAC
# counts, the ED1A ancestry PCs, and the sex and cell-type DA fits' raw counts.
# The epigenomics DA tables are a public HTTPS download and do not use it.
export GSUTIL="${GSUTIL:-gsutil}"

# The bucket the raw quantification files live under. SF1C-SF1F resolve the
# muscle ATAC raw peak counts by listing it; analysis/01_sex_da.R and
# analysis/02_celltype_da.R fit their models on the raw RSEM counts under it.
# Neither data package carries either.
export QUANT_BUCKET="${QUANT_BUCKET:-gs://motrpac-data-hub/quant-id/human-precovid}"

# ---- ED1A: where its participant PCs come from -----------------------------
# data_hub    the released resource, 174 participants (default)
# cached_pca  the vendored snpgdsPCA object, 238 samples
#
# The vendored object is individual-level genotype data and is not in this
# repository, so cached_pca needs approved consortium data access and a local
# copy. Either way the 1000 Genomes reference cloud comes from that object; the
# release publishes no coordinate for a reference sample, so ED1A cannot be
# drawn here at all. See figures/landscape/README.md.
export ED1A_PC_SOURCE="${ED1A_PC_SOURCE:-data_hub}"

# ---- FIG1C, ED1B, ED1D and SF1: the epigen QC cache ------------------------
# Neither data package ships the ATAC or methylCap QC matrices; they are read
# from the consortium bucket at run time and cached here. About 6 GB of
# tab-delimited matrices on the first cold run, nothing on every run after it.
# The directory not existing yet is the normal first-run state: it is created on
# demand by the download.
#
# One variable for every panel that reads it, deliberately. They read the same
# matrices out of the same collection, and two names for one cache is two caches
# on the first machine where only one of them is set. SF1 also downloads the
# muscle ATAC raw peak counts into it.
export EPIGEN_QC_DIR="${EPIGEN_QC_DIR:-${LANDSCAPE_ROOT}/staging/raw-files}"

# ---- analysis/01_sex_da.R: the sex-stratified differential analysis --------
# ED3A is drawn from a differential analysis neither data package carries,
# fitted under `~ 0 + sex_group_timepoint + <covariates> + (1 | pid)`.
# analysis/01_sex_da.R writes it here; ED3A reads the directory through this
# name and takes an override, so pointing it at tables fitted elsewhere skips
# the fit entirely.
#
# The tables are large (blood transcriptomics alone is ~258 MB) and the fit takes
# hours, so a complete table is reused rather than refitted.
export SEX_STRATIFIED_DA_DIR="${SEX_STRATIFIED_DA_DIR:-${LANDSCAPE_ROOT}/outputs/fits/sex_da}"

# ---- analysis/02_celltype_da.R: the cell-type sensitivity analysis ---------
# ED3E plots the released blood RNA-seq acute DA against a re-fit of it that
# additionally carries five deconvolution-derived cell fractions as covariates.
# ED3E pins its file under this directory by model name plus tissue and assay.
#
# The deconvolution those covariates come from is not in this repository and may
# not be released. Neither the fit nor ED3D and ED3E can be run here; see the
# README.
export CELLTYPE_DA_DIR="${CELLTYPE_DA_DIR:-${LANDSCAPE_ROOT}/outputs/fits/celltype_da}"

# Deliberately not defaulted. Set it to a single table fitted elsewhere and ED3E
# reads that instead of looking under CELLTYPE_DA_DIR, which is the one way to
# draw ED3E without the gated deconvolution.
export ED3E_DA_WITH_CELL_TYPES="${ED3E_DA_WITH_CELL_TYPES:-}"

# ---- analysis/03_clinical_omics.R: baseline clinical x omics associations --
# ED4G, FIG3EFG and tables/EDT1.R are all drawn from one fit: a linear model of
# each baseline feature on each baseline clinical trait, adjusted for BMI, sex
# and age, plus randomGroupCode for Lactate. Site is not a covariate. One fit
# rather than three, so three scripts cannot refit it three ways.
export CLINICAL_OMICS_TABLE="${CLINICAL_OMICS_TABLE:-${LANDSCAPE_ROOT}/outputs/fits/clinical_omics/clinical_omics_associations.tsv}"

# Points FIG3EFG and ED4G at a fit produced elsewhere, overriding
# CLINICAL_OMICS_TABLE for the panels alone.
export FIG3_CLINICAL_OMICS_TABLE="${FIG3_CLINICAL_OMICS_TABLE:-}"

# The trait list that fit covers. Every trait is fitted; ED4G then draws only
# the rows that found something, so a trait that starts producing hits appears
# on its own rather than needing this list edited.
export CLINICAL_OMICS_TRAITS="${CLINICAL_OMICS_TRAITS:-VO2max_L,HOMA_IR,Lactate,NEFA,cp_rest_corrected_rmat,lp_rest_corrected_rmat,le_rest_corrected_rmat,peaktorq_iske,peak_handgrip}"

# ---- analysis/04_plier.R: where the two cross-tissue PLIER fits live -------
# The path only. What the fit is ASKED for — how many latent variables, which
# ones the panels draw — is hand-set per figure and lives beside the helper that
# reads it, in figure_4/plier_lvs.env.
export PLIER_DIR="${PLIER_DIR:-${LANDSCAPE_ROOT}/outputs/fits/plier}"

# ---- The c-means cluster numbers -------------------------------------------
# Not here. Every hand-set cluster number for FIG4 and ED5 — which clusters
# carry the VEGF signal, which pair up across tissues, the FIG4C label
# placement overrides — sits in figure_4/cmeans.env, which
# figure_4/FIG4_ED5_helpers.R sources on load. One file, so the next re-clustering is one edit.
