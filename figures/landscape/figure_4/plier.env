# analysis/04_plier.R — the parameters of the two cross-tissue PLIER fits.
#
# One PLIER per ome over one matrix holding every tissue at once: the RNA arm
# over the genes all three tissues measure against the nine gene-set databases,
# the metabolomics arm over the shared metabolites against the RefMet classes.
# Off each fit comes the LV x comparison response grid every bubble panel draws.
# FIG4G, FIG4H and all ten ED6 panels read those fits and none of them refits.
#
# NOT config/plier_lvs.env. That file holds the hand-set latent-variable
# SELECTIONS the panels draw — which LV numbers, which marker cutoff, which LV
# gets a heatmap — and lib/plier_helpers.R reads it on load. This file holds the
# parameters of the FIT that produces the latent variables those numbers index.
# The two declare disjoint variable sets; a value belongs here when changing it
# changes the fit, and there when it only changes what is drawn off one.
#
# Read from R by analysis/04_plier.R, which parses it the way
# lib/panel_export.R parses config/landscape.env: a line parser, not a shell.
# Values already exported WIN, which is how a one-off override works:
#
#   PLIER_FORCE=TRUE Rscript figures/landscape/analysis/04_plier.R
#
# ${LANDSCAPE_ROOT} is the only substitution a value may carry. Anything else —
# a nested expansion, a backtick, a command substitution — is left unresolved
# and the variable stays unset.
#
# One variable this fit reads is NOT here, because every PLIER panel reads it
# too and config/landscape.env is where those live:
#   PLIER_DIR    where the fits are written and where the panels read them

# ---- what is fitted ---------------------------------------------------------

# Which arms are fitted. Each is one PLIER over one cross-tissue matrix.
export PLIER_ARMS="${PLIER_ARMS:-rna,metab}"

# PLIER is asked for k = 2 x this. The legacy used double the num.pc() estimate
# and capped it: num.pc() on the cross-tissue RNA matrix does not finish in
# reasonable time, so 50 (100 LVs) is asserted for RNA and computed-then-capped
# for metabolomics.
export PLIER_K_HALF="${PLIER_K_HALF:-50}"

# num.pc() is run for the metabolomics arm and its answer capped at PLIER_K_HALF.
# FALSE asserts PLIER_K_HALF there too, which is how to reproduce a fit whose
# num.pc() answer differed.
export PLIER_METAB_USE_NUM_PC="${PLIER_METAB_USE_NUM_PC:-TRUE}"

# Handed to PLIER() as frac= and seed=. The legacy's values.
export PLIER_FRAC="${PLIER_FRAC:-0.7}"
export PLIER_SEED="${PLIER_SEED:-1}"

# ---- the record of the fit --------------------------------------------------

# One row per fitted arm: the file, the matrix and prior sizes, k, frac, seed,
# how long it took. Written beside the fits.
export PLIER_MANIFEST_TSV="${PLIER_MANIFEST_TSV:-${LANDSCAPE_ROOT}/outputs/fits/plier/plier_manifest.tsv}"

# The version suffix on the written objects. Not a release number — this fit has
# never been published to a bucket — it is the collection version it was fitted
# FROM, which is the fact that decides what its latent variables mean. Tracks the
# data-package versions the panels are built against.
export PLIER_VERSION="${PLIER_VERSION:-2.0}"

# ---- reuse ------------------------------------------------------------------

# Refit an arm already on disk. Off by default: the RNA fit is a 100-latent-
# variable PLIER over 14,428 genes x 1,554 samples against 8,482 gene sets, and
# takes a bit over two hours and ~8.5 GB. A fit on disk with no response grid
# beside it has only the grid rebuilt, which is minutes.
export PLIER_FORCE="${PLIER_FORCE:-FALSE}"
