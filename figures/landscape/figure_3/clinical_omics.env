# analysis/03_clinical_omics.R — the parameters of the baseline clinical x omics
# fit, in one file.
#
# One linear model per feature per trait per tissue per ome, fitted on the
# pre-exercise samples:
#
#   feature ~ trait + BMI + Sex + age  (+ TOTAL_LEAN, optionally)
#
# FIG3EFG, ED4G, tables/ST3.R (ST3g, ST3h) and tables/EDT1.R are five readings
# of the one table it writes. Refitting is an edit to this file and nothing
# else.
#
# Read from R by analysis/03_clinical_omics.R, which parses it the way
# lib/panel_export.R parses config/landscape.env: a line parser, not a shell.
# Values already exported WIN, which is how a one-off override works:
#
#   CLINICAL_OMICS_FORCE=TRUE Rscript figures/landscape/analysis/03_clinical_omics.R
#
# ${LANDSCAPE_ROOT} is the only substitution a value may carry. Anything else —
# a nested expansion, a backtick, a command substitution — is left unresolved
# and the variable stays unset.
#
# Two variables this fit reads are NOT here, because a figure script reads them
# too and config/landscape.env is where those live:
#   CLINICAL_OMICS_TABLE    the table this writes and five scripts read
#   CLINICAL_OMICS_TRAITS   the trait list, which ED4G also reads

# ---- the record of the fit --------------------------------------------------

# One row describing the run: version, grid size, covariates, data-package
# version, timestamp. Written beside the table, and its presence is what makes a
# completed fit reusable.
export CLINICAL_OMICS_MANIFEST_TSV="${CLINICAL_OMICS_MANIFEST_TSV:-${LANDSCAPE_ROOT}/outputs/fits/clinical_omics/clinical_omics_manifest.tsv}"

# ---- the grid that is fitted ------------------------------------------------

# A combination that does not exist — an ome not assayed in a tissue — is
# skipped and recorded, not failed.
export CLINICAL_OMICS_TISSUES="${CLINICAL_OMICS_TISSUES:-muscle,blood,adipose}"
export CLINICAL_OMICS_OMES="${CLINICAL_OMICS_OMES:-transcript-rna-seq,prot-pr,prot-ol,metab}"

# ---- the model --------------------------------------------------------------

# Whether TOTAL_LEAN joins the covariate set. FALSE fits the model above; the
# legacy call also fitted site, so neither value reproduces it.
export CLINICAL_OMICS_ADJUST_LEAN="${CLINICAL_OMICS_ADJUST_LEAN:-FALSE}"

# The smallest residual degrees of freedom a feature's model may have and still
# be reported. A fit below it is reported as missing and stays out of the BH
# correction.
export CLINICAL_OMICS_MIN_RESIDUAL_DF="${CLINICAL_OMICS_MIN_RESIDUAL_DF:-5}"

# ---- reuse ------------------------------------------------------------------

# 2.1: site dropped from the covariates; a feature named after the trait is
# dropped from that combination's input rather than failing it.
# 2.2: residual df floor of 5; peak lactate is post 10 min for both exercise
# groups and its fit carries randomGroupCode as a covariate.
export CLINICAL_OMICS_VERSION="${CLINICAL_OMICS_VERSION:-2.2}"

# Tens of minutes, not the hours the sex-stratified and cell-type fits take, but
# a table already recorded in the manifest is still reused rather than refitted.
export CLINICAL_OMICS_FORCE="${CLINICAL_OMICS_FORCE:-FALSE}"
