# Cross-tissue PLIER figures — the hand-set latent-variable numbers, in one file.
#
# FIG4G, FIG4H and every ED6 panel select latent variables by number: which LVs
# carry a cross-tissue response worth showing, which one gets its own marker
# heatmap, which get a pathway bar plot. The numbers below are the legacy's, read
# off its two fits and written down.
#
# They hold because analysis/04_plier.R reproduces those fits rather than making
# new ones — same input matrices, same prior, same k, frac and seed, and the
# same column order. PLIER is not invariant to column order, so the fit runs in
# assembly order and sorts to display order afterwards, which is what the legacy
# scripts did.
#
# A latent variable is a coordinate in a decomposition, not a name. Move the
# data-package pins, k, frac or seed and the numbering moves with them, and PLIER
# can split or merge what an LV represents. After any such change, re-decide the
# selections against the new fit: plier_lv_response_stats() in
# lib/plier_helpers.R gives each latent variable's cross-tissue correlations and
# how many of the 22 response cells it clears 0.05 in, and every panel reports
# the LVs it drew and their marker counts, which is where a mismatch shows
# first.
#
# Read from R with plier_lvs("RNA") in lib/plier_helpers.R, which parses the
# comma-separated lists and fails loudly on an unset name.
#
# Read on load by lib/plier_helpers.R, so a panel gets these by sourcing the
# helper and nothing else, and sourced directly by analysis/04_plier.R. Nothing
# else sees them: where the fits are WRITTEN is PLIER_DIR, which belongs to
# config/landscape.env. This file is only what was decided by hand.

# ---- Which latent variables the panels draw ---------------------------------

# The LVs FIG4G, FIG4H, ED6A, ED6Aii, ED6B, ED6C and ED6D are built on, in fit
# order. They are the eight the legacy selected off the RNA fit.
export PLIER_RNA_LVS="${PLIER_RNA_LVS:-6,13,15,33,54,73,79,84}"

# The seven the legacy selected off the metabolomics fit, drawn by ED6E, ED6F,
# ED6G, ED6H and ED6I.
export PLIER_METAB_LVS="${PLIER_METAB_LVS:-4,11,17,27,30,65,67}"

# A feature is a marker of an LV when its affinity (PLIER's Z) is more than this
# many standard deviations above the mean. The two arms use different cutoffs and
# they are the legacy's: 3 over the RNA Z, 2 over the metabolomics Z, which has
# far fewer features to spread over.
export PLIER_RNA_MARKER_SD="${PLIER_RNA_MARKER_SD:-3}"
export PLIER_METAB_MARKER_SD="${PLIER_METAB_MARKER_SD:-2}"

# ED6D and ED6I each draw ONE LV's top markers across every sample. Which one.
export PLIER_RNA_MARKER_HEATMAP_LV="${PLIER_RNA_MARKER_HEATMAP_LV:-33}"
export PLIER_METAB_MARKER_HEATMAP_LV="${PLIER_METAB_MARKER_HEATMAP_LV:-17}"

# How many top-affinity features that heatmap shows.
export PLIER_MARKER_HEATMAP_N="${PLIER_MARKER_HEATMAP_N:-10}"

# ED6Aii draws a top-pathway bar plot for these LVs, and only these. The legacy
# drew three, one per LV it highlighted in the ED6A schematic.
export PLIER_RNA_PATHWAY_BARPLOT_LVS="${PLIER_RNA_PATHWAY_BARPLOT_LVS:-13,15,33}"

# How many pathways FIG4H takes from each LV before taking the union. The legacy
# took 5 from most LVs and fewer from two of them (4 from LV15, 1 from LV54 and
# LV84) because that is where their AUC ran out; the panel takes 5 from each and
# drops any whose AUC is 0, which is the same intent stated as a rule.
export PLIER_PATHWAYS_PER_LV="${PLIER_PATHWAYS_PER_LV:-5}"
