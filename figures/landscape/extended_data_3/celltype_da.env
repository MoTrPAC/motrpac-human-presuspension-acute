# analysis/02_celltype_da.R — the cell-type sensitivity analysis, parameterised.
#
# ED3E plots the released blood RNA-seq acute differential analysis against a
# re-fit of it that additionally carries five deconvolution-derived cell
# fractions as covariates. analysis/02_celltype_da.R sources this file on load,
# so a refit is an edit here and nothing else.
#
# NEITHER THE FIT NOR ED3D AND ED3E CAN BE RUN FROM THIS REPOSITORY. The
# deconvolution the five covariates come from is individual-level data, is not
# distributed here and may not be published; see the note at the top of
# analysis/02_celltype_da.R and figures/landscape/README.md.
#
# Values already exported WIN, which is how a one-off override works:
#
#   CELLTYPE_DA_FORCE=TRUE Rscript figures/landscape/analysis/02_celltype_da.R
#
# Shell syntax, because it is a list of settings and reads like one, but it is
# parsed by a line reader rather than run through a shell: one `export NAME=...`
# per line, and no substitution in a value except ${LANDSCAPE_ROOT}.
#
# CELLTYPE_DA_DIR is NOT here. ED3E reads the fit's output directory too, so it
# is declared once in config/landscape.env and this file does not redefine it.
# ED3E_DA_WITH_CELL_TYPES, the override that points the panel at a table fitted
# elsewhere, is there for the same reason.

# ---- where the table is written --------------------------------------------
# One row per written table: the formula, which five covariates entered it, the
# feature, contrast and sample counts, the counts source, the deconvolution it
# was built from, the two data-package versions and the eBayes estimator. A
# table listed there is reused, not refitted.
export CELLTYPE_DA_MANIFEST_TSV="${CELLTYPE_DA_MANIFEST_TSV:-${LANDSCAPE_ROOT}/outputs/fits/celltype_da/celltype_da_manifest.tsv}"

# ---- what is fitted ---------------------------------------------------------

# Which tissues are fitted. Blood and nothing else, and that is not a default so
# much as the scope of the input: the deconvolution is of bulk RNA-seq against
# LM22, a leukocyte signature matrix, so no other tissue has a cell fraction to
# add to its design.
export CELLTYPE_DA_TISSUES="${CELLTYPE_DA_TISSUES:-blood}"

# The deconvolution the five covariates come from. This is the SAME file ED3D
# plots, deliberately: one copy means the fractions in the model and the
# fractions in the figure cannot drift apart.
#
# The path is where a copy would go for anyone holding an approved consortium
# data-access request. The file itself is not in this repository and is
# absent from this repository; name a copy held outside the checkout.
export CELLTYPE_DA_CIBERSORTX_CSV="${CELLTYPE_DA_CIBERSORTX_CSV:-${LANDSCAPE_ROOT}/extended_data_3/sources/CIBERSORTx_PrecovidBlood_RNADecon_Results_081226.csv}"

# ---- how it is fitted -------------------------------------------------------

# Cores handed to variancePartition. 1 disables parallelism. MulticoreParam
# forks, so this is a no-op on Windows; on macOS and Linux each worker inherits
# an already-armed warning cache, which is what makes fork rather than SOCK the
# right backend here (see .celltype_da_bpparam() in analysis/02_celltype_da.R).
# It is declared in config/sex_da.env as well - the two fits share the name,
# deliberately, and whichever file is read first sets it.
export VARIANCEPARTITION_PARALLEL_CORES="${VARIANCEPARTITION_PARALLEL_CORES:-1}"

# The version suffix on the written table. Like SEX_DA_VERSION this is not a
# release number - the cell-type sensitivity analysis has never been published
# to a bucket - it is the collection version the table was fitted FROM. The
# legacy artifact carried v1.3; 2.0 tracks the data-package pins in
# config/required_packages.tsv, so a table fitted here is not mistakable for the
# one fitted against the v1.3 objects. What the table actually is, is recorded
# in celltype_da_manifest.tsv.
export CELLTYPE_DA_VERSION="${CELLTYPE_DA_VERSION:-2.0}"

# Refit a table that is already on disk. Off by default: the table is ~330 MB
# and the fit is hours, so a table already recorded in the manifest is reused
# rather than refitted.
export CELLTYPE_DA_FORCE="${CELLTYPE_DA_FORCE:-FALSE}"
