# analysis/01_sex_da.R — the sex-stratified differential analysis, parameterised.
#
# ED3A and ST2g are drawn from a differential analysis neither data package
# carries, fitted under `~ 0 + sex_group_timepoint + <covariates> + (1 | pid)`.
# analysis/01_sex_da.R sources this file on load, so a refit is an edit here and
# nothing else.
#
# Values already exported WIN, which is how a one-off override works:
#
#   SEX_DA_TISSUES=blood Rscript figures/landscape/analysis/01_sex_da.R
#
# Shell syntax, because it is a list of settings and reads like one, but it is
# parsed by a line reader rather than run through a shell: one `export NAME=...`
# per line, and no substitution in a value except ${LANDSCAPE_ROOT}.
#
# What the PANELS read is in config/landscape.env, not here:
# SEX_STRATIFIED_DA_DIR is ED3A's name for this fit's output directory.

# ---- where the tables are written ------------------------------------------
# The same directory config/landscape.env defaults SEX_STRATIFIED_DA_DIR to.
# The two defaults have to agree, or ED3A reads a directory nothing writes;
# change them together.
export SEX_DA_DIR="${SEX_DA_DIR:-${LANDSCAPE_ROOT}/outputs/fits/sex_da}"

# One row per written table: the formula, the feature, contrast and sample
# counts, the counts source, the two data-package versions and the eBayes
# estimator. A table listed there is reused, not refitted.
export SEX_DA_MANIFEST_TSV="${SEX_DA_MANIFEST_TSV:-${LANDSCAPE_ROOT}/outputs/fits/sex_da/sex_da_manifest.tsv}"

# ---- what is fitted ---------------------------------------------------------

# Which tissues are fitted. ED3A plots blood transcriptomics only; muscle and
# adipose are in the default because ST2g reports the sex-stratified results in
# all three. `all` fits every tissue that qualifies (see analysis/01_sex_da.R
# for what qualifying means).
export SEX_DA_TISSUES="${SEX_DA_TISSUES:-blood,muscle,adipose}"

# Which tissues are fitted for METABOLOMICS, as its own list rather than sharing
# SEX_DA_TISSUES. The two modalities are not wanted for the same tissues, and a
# single list could not say that.
#
# Blood and muscle, not adipose, and that is a property of the data rather than a
# preference. The qualifying rule drops controls BEFORE counting, so adipose
# passes on its exercise cells; but the sex contrasts reference the control cells
# anyway, and every adipose metabolomics platform has a male control cell of
# n = 1 (post_15_30_45_min and post_24_hr). A group x timepoint x sex level with
# one observation under a single (1 | pid) intercept is what breaks the contrast
# construction. Blood's smallest control cell is 4 and muscle's is 3.
#
# Each qualifying platform is fitted separately - the platform is the ome for
# metabolomics - and ST2g pools them into one Metabolomics row per tissue x group
# x timepoint. The matrices are small, so these fits are minutes rather than the
# hours a transcriptomics fit takes.
export SEX_DA_METAB_TISSUES="${SEX_DA_METAB_TISSUES:-blood,muscle}"

# ---- how it is fitted -------------------------------------------------------

# Cores handed to variancePartition. 1 disables parallelism. MulticoreParam
# forks, so this is a no-op on Windows; on macOS and Linux each worker inherits
# an already-armed warning cache, which is what makes fork rather than SOCK the
# right backend here (see .sex_da_bpparam() in analysis/01_sex_da.R).
export VARIANCEPARTITION_PARALLEL_CORES="${VARIANCEPARTITION_PARALLEL_CORES:-1}"

# The version suffix on the written tables. The sex-stratified analysis has never
# been published to a bucket, so this is not a release number - it is the
# collection version the tables were fitted FROM, which is the fact that decides
# what they mean. 2.0 tracks the data-package pins in
# config/required_packages.tsv; change both together or not at all. What each
# table actually is, is recorded per-table in sex_da_manifest.tsv.
export SEX_DA_VERSION="${SEX_DA_VERSION:-2.0}"

# Refit tables that are already on disk. Off by default: the blood
# transcriptomics table alone is ~258 MB and the fit is hours, so a table
# already recorded in the manifest is reused rather than refitted.
export SEX_DA_FORCE="${SEX_DA_FORCE:-FALSE}"
